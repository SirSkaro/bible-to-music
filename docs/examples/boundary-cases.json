{
  "description": "A synthetic edition for an offline song-boundary preview. Positions are after a whole word, numbered from 1 within each verse. Expected sets below are hand-authored. The sample probes specific positions, not every word in the fixture.",
  "edition": "synthetic-choir-v1",
  "verses": [
    {
      "id": "1:1",
      "text": "At dawn the singers gathered"
    },
    {
      "id": "1:2",
      "text": "beside the river;"
    },
    {
      "id": "1:3",
      "text": "then the bells rang. The choir waited; everyone listened."
    },
    {
      "id": "1:4",
      "text": "Dr. Vale called, “Ready?”"
    }
  ],
  "policies": {
    "sentence": {
      "permitted_endings": "sentence",
      "require_verse_end": false
    },
    "sentence_at_verse": {
      "permitted_endings": "sentence",
      "require_verse_end": true
    },
    "clause": {
      "permitted_endings": "sentence_or_semicolon",
      "require_verse_end": false
    },
    "clause_at_verse": {
      "permitted_endings": "sentence_or_semicolon",
      "require_verse_end": true
    },
    "any_word": {
      "permitted_endings": "any_whole_word",
      "require_verse_end": false
    },
    "any_word_at_verse": {
      "permitted_endings": "any_whole_word",
      "require_verse_end": true
    }
  },
  "probes": [
    {
      "id": "continuing_verse",
      "verse": "1:1",
      "after_word": 5,
      "word": "gathered",
      "accepted_by": [
        "any_word",
        "any_word_at_verse"
      ]
    },
    {
      "id": "verse_semicolon",
      "verse": "1:2",
      "after_word": 3,
      "word": "river;",
      "accepted_by": [
        "clause",
        "clause_at_verse",
        "any_word",
        "any_word_at_verse"
      ]
    },
    {
      "id": "internal_sentence",
      "verse": "1:3",
      "after_word": 4,
      "word": "rang.",
      "accepted_by": [
        "sentence",
        "clause",
        "any_word"
      ]
    },
    {
      "id": "internal_semicolon",
      "verse": "1:3",
      "after_word": 7,
      "word": "waited;",
      "accepted_by": [
        "clause",
        "any_word"
      ]
    },
    {
      "id": "completed_verse",
      "verse": "1:3",
      "after_word": 9,
      "word": "listened.",
      "accepted_by": [
        "sentence",
        "sentence_at_verse",
        "clause",
        "clause_at_verse",
        "any_word",
        "any_word_at_verse"
      ]
    },
    {
      "id": "abbreviation",
      "verse": "1:4",
      "after_word": 1,
      "word": "Dr.",
      "accepted_by": [
        "any_word"
      ]
    },
    {
      "id": "quoted_question",
      "verse": "1:4",
      "after_word": 4,
      "word": "“Ready?”",
      "accepted_by": [
        "sentence",
        "sentence_at_verse",
        "clause",
        "clause_at_verse",
        "any_word",
        "any_word_at_verse"
      ]
    }
  ],
  "plan_examples": [
    {
      "description": "A semicolon at a verse end can be a pinned song break.",
      "source_verses": [
        "1:1",
        "1:4"
      ],
      "policy": "clause_at_verse",
      "internal_cuts": [
        "verse_semicolon"
      ],
      "outcome": "valid",
      "song_ends": [
        "verse_semicolon",
        "quoted_question"
      ]
    },
    {
      "description": "The same pinned break conflicts with sentence-only mode.",
      "source_verses": [
        "1:1",
        "1:4"
      ],
      "policy": "sentence_at_verse",
      "internal_cuts": [
        "verse_semicolon"
      ],
      "outcome": "invalid_cut",
      "conflict": "verse_semicolon"
    },
    {
      "description": "A song may end inside a verse when the sentence ends there.",
      "source_verses": [
        "1:1",
        "1:4"
      ],
      "policy": "sentence",
      "internal_cuts": [
        "internal_sentence"
      ],
      "outcome": "valid",
      "song_ends": [
        "internal_sentence",
        "quoted_question"
      ]
    },
    {
      "description": "Verse-end-only excludes an internal sentence ending.",
      "source_verses": [
        "1:1",
        "1:4"
      ],
      "policy": "sentence_at_verse",
      "internal_cuts": [
        "internal_sentence"
      ],
      "outcome": "invalid_cut",
      "conflict": "internal_sentence"
    },
    {
      "description": "The fixed end of the source is checked even when it is the only song end.",
      "source_verses": [
        "1:1",
        "1:1"
      ],
      "policy": "sentence",
      "internal_cuts": [],
      "outcome": "invalid_source_end",
      "conflict": "continuing_verse"
    },
    {
      "description": "An entire source may be a single song.",
      "source_verses": [
        "1:1",
        "1:3"
      ],
      "policy": "sentence_at_verse",
      "internal_cuts": [],
      "outcome": "valid",
      "song_ends": [
        "completed_verse"
      ]
    }
  ]
}
